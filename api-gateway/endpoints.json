        {
          "path": "/api/organizations/{organization_id}/clients",
          "method": "GET",
          "operation_id": "list_clients_api_organizations__organization_id__clients_get",
          "summary": "Get all clients for an organization",
          "description": "Get a paginated list of clients with optional search filters.\n\n**Search filters**\n- `clientName`: Client name (supports wildcards)\n- `clientGln`: Client GLN code\n- `status`: Client status (0=Pending, 1=Active, 2=Inactive, 3=Deleted)\n- `nationality`: Client nationality code (e.g., CR, US)\n- `idNumber`: Identification number\n\n**Sorting**\n- `orderBy>field` (Ascending)\n- `orderBy<field` (Descending)\n- Sortable fields: `clientName`, `clientGln`, `status`, `nationality`, `createdOn`, `updatedOn`\n\n**Examples:**\n- Search by name: `clientName:*corp*`\n- Search pending clients: `status:0`\n- Search by nationality and ID: `nationality:CR,idNumber:123456789`\n- Combined: `status:0,nationality:CR,orderBy>clientName`",
          "path_params": [
            {
              "name": "organization_id",
              "type": "string",
              "required": true,
              "description": "Organization identifier"
            }
          ],
          "query_params": [
            {
              "name": "search",
              "type": "string",
              "required": false,
              "description": "Search filter string. Syntax: field:value,field2:value2. Supports operators: : (equal), ! (not equal), > (greater), < (less), ~ (like). Example: clientName:*Test*,orderBy>clientName"
            },
            {
              "name": "page",
              "type": "integer",
              "required": false,
              "description": "Page number (1-indexed)"
            },
            {
              "name": "pageSize",
              "type": "integer",
              "required": false,
              "description": "Items per page"
            }
          ],
          "response": {
            "is_list": false,
            "fields": []
          }
        },
